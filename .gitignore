# Secrets generated by Ansible — never commit these.
inventories/*/credentials/
inventories/*/group_vars/all/vault.yml
# Your fleets (keep them in a private repo if you want them versioned); the example stays tracked.
inventories/*
!inventories/example/

.venv/
__pycache__/
*.retry
tests/e2e/.ssh/
tests/e2e/inventory/credentials/
*.pyc
