# A systemd-enabled Ubuntu "server" for end-to-end tests.
FROM ubuntu:24.04
ENV container=docker DEBIAN_FRONTEND=noninteractive
# Package mirrors fail now and then. Retry downloads, and make a failed index download an error:
# plain `apt-get update` exits 0 without having fetched anything, and the next install then fails
# with "Unable to locate package". python3-apt ships with Ubuntu server/cloud images; without it,
# Ansible's apt module installs it after a single unchecked `apt-get update` (the CI flake).
RUN set -e; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3; do apt-get update --error-on=any && break; [ "$i" = 3 ] && exit 1; sleep 10; done; \
    apt-get install -y --no-install-recommends systemd systemd-sysv openssh-server sudo python3 \
      python3-apt ca-certificates iproute2; \
    rm -rf /var/lib/apt/lists/*; \
    systemctl enable ssh; \
    useradd -m -s /bin/bash tester; \
    echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester; \
    install -d -m 700 -o tester -g tester /home/tester/.ssh
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
