# The machine that runs Ansible in the end-to-end test.
FROM python:3.12-slim
ARG ANSIBLE_CORE=ansible-core>=2.16,<2.20
# Retry flaky mirrors; --error-on=any makes a failed index download fail instead of exiting 0.
RUN set -e; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3; do apt-get update --error-on=any && break; [ "$i" = 3 ] && exit 1; sleep 10; done; \
    apt-get install -y --no-install-recommends openssh-client curl jq; \
    rm -rf /var/lib/apt/lists/*; \
    pip install --no-cache-dir --retries 5 "${ANSIBLE_CORE}"
WORKDIR /work
