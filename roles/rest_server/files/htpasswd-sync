#!/usr/bin/env bash
# Sync a rest-server htpasswd file with "user password" lines read from stdin (neither may
# contain whitespace; restic-fleet generates alphanumeric passwords).
# Existing users whose password still verifies are left untouched (bcrypt hashes are salted,
# so rewriting them would change the file on every run); users not listed are removed.
# Prints CHANGED when the file was modified. rest-server reloads the file by itself.
set -euo pipefail
umask 077
file=$1
touch "$file"
changed=0
declare -A wanted=()

while read -r user pass; do
  [ -n "$user" ] || continue
  if [[ ! $user =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "invalid user name: $user" >&2
    exit 2
  fi
  wanted[$user]=1
  if ! printf '%s' "$pass" | htpasswd -i -v "$file" "$user" >/dev/null 2>&1; then
    printf '%s' "$pass" | htpasswd -i -B -C 10 "$file" "$user" >/dev/null 2>&1
    changed=1
  fi
done

while IFS=: read -r user _; do
  if [ -n "$user" ] && [ -z "${wanted[$user]:-}" ]; then
    htpasswd -D "$file" "$user" >/dev/null 2>&1
    changed=1
  fi
done < <(cat "$file")

chown root:restic "$file"
chmod 0640 "$file"
if [ "$changed" = 1 ]; then
  echo CHANGED
fi
