# {{ ansible_managed }}
[Unit]
Description=restic-fleet: collect repository statistics for the dashboard
After=restic-fleet-dashboard.service

[Service]
Type=oneshot
User=restic-maint
Group=restic
SupplementaryGroups=restic-maint
ExecStart=/usr/local/sbin/restic-fleet-server collect
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
{% include 'hardening.j2' %}
