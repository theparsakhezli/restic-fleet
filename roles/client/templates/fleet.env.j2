# {{ ansible_managed }}
# Loaded by restic-fleet-backup and rfleet. Contains credentials: keep it root-only (0600).
RESTIC_REPOSITORY={{ _restic_env.RESTIC_REPOSITORY }}
RESTIC_REST_USERNAME={{ inventory_hostname }}
RESTIC_REST_PASSWORD={{ _rest_password }}
RESTIC_PASSWORD_FILE={{ fleet_etc }}/repo.pass
RESTIC_CACERT={{ fleet_etc }}/ca.crt
RESTIC_CACHE_DIR={{ fleet_cache_dir }}
RESTIC_COMPRESSION={{ fleet_compression }}
RESTIC_PACK_SIZE={{ fleet_pack_size_mib }}
FLEET_HOST={{ inventory_hostname }}
# Always the server itself (fleet CA), even if people reach the dashboard through a proxy.
FLEET_REPORT_URL=https://{{ fleet_server_url_host }}:{{ fleet_dashboard_port }}/api/v1/report
FLEET_ONE_FILE_SYSTEM={{ 1 if backup_one_file_system | bool else 0 }}
FLEET_EXCLUDE_CACHES=1
